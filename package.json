{
  "name": "coco-rin-booking",
  "version": "1.0.0",
  "description": "Booking system for coco-rin",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run push",
    "build": "cd frontend && npm run build",
    "deploy": "npm run build && cd backend && npm run deploy"
  }
} 